{
  "schemaVersion": 1,
  "date": "2026-10-16",
  "title": "Physical layout and media-fit evidence for game-box reproductions",
  "scope": "Five reproductions contain their exact published media at original scale. Neutral templates remain empty. This record distinguishes verified digital fit from approximate historical construction.",
  "units": "millimeters unless a field explicitly names meters",
  "axes": {
    "x": "right",
    "y": "up",
    "z": "toward the printed front / label face"
  },
  "validation": {
    "tool": "tools/audit_box_content_fit.py",
    "command": "blender --background --python tools/audit_box_content_fit.py -- --models-root <reproductions-directory> --output <report.json>",
    "engine": "Blender 5.2.2 LTS",
    "testedPoses": [
      "closed",
      "fully open hinge endpoints"
    ],
    "method": "Decoded GLB world triangles; Blender BVHTree overlap, epsilon=0.",
    "broadPhaseAabbToleranceMeters": 1e-07,
    "summary": "Zero media-to-packaging intersecting triangle pairs in all five final exports at both tested endpoints.",
    "limits": [
      "This checks surface crossings in the digital meshes and complements the listed cavity clearances; it is not a manufacturing, elastic deformation or insertion-path test.",
      "The current Open animation rotates hinges. Nintendo insert removal and NES sleeve extraction remain editable operations rather than automatic actions in that animation.",
      "Photo-derived dimensions and construction details remain approximate; these are not certified exact factory complete-in-box replicas."
    ]
  },
  "sources": [
    {
      "id": "sonic-pal-tradera-interior",
      "title": "Sonic the Hedgehog PAL physical clamshell specimen",
      "url": "https://www.tradera.com/item/340720/717550997/sonic-the-hedgehog-sega-mega-drive",
      "imageUrl": "https://img.tradera.net/images/748/634489748_123f7dd7-e2d7-41a7-b8c5-88590ba9b690.jpg",
      "observations": [
        "Black clamshell with broad spine, two hinge flexures, booklet retainers and two cartridge guide channels.",
        "Cartridge label faces the open interior; its width follows case height, with cartridge top toward the hinge."
      ],
      "limitations": [
        "Used specimen photographed obliquely without a ruler; not a factory dimension drawing or proof of packing orientation."
      ]
    },
    {
      "id": "sonic-pal-ricardo-manual",
      "title": "Open PAL Sonic case with manual under lid tabs",
      "url": "https://www.ricardo.ch/de/a/4-sega-mega-drive-games-sonic-und-mortal-kombat-1292663282/",
      "imageUrl": "https://img.ricardostatic.ch/images/682c0dd8-521f-4365-abc7-e117f868e6a3/t_1800x1350/4-sega-mega-drive-games-sonic-und-mortal-kombat",
      "observations": [
        "The landscape manual is stored sideways inside the portrait lid, front cover facing the interior.",
        "In an open case viewed with the lid on the left, the blue SONIC title is above the Sonic illustration; the top edge of the landscape cover points toward the outside edge of the lid.",
        "The cartridge is rotated 180 degrees relative to the Tradera specimen, so used storage orientation is not universal."
      ],
      "limitations": [
        "Used sale specimen; no ruler, page count or factory packing certification."
      ]
    },
    {
      "id": "sonic-pal-original-manual",
